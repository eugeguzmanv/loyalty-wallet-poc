PORT=3000
BASE_URL=http://localhost:3000
BUSINESS_NAME=Demo Coffee
PROGRAM_TYPE=stamps
STAMP_THRESHOLD=8
POINTS_PER_VISIT=10
CURRENCY=MXN

# Google Wallet (optional for local mock mode; required for real Google Wallet links)
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
GOOGLE_CLASS_SUFFIX=loyalty_demo

# Apple Wallet (requires Apple Developer Pass Type ID certificate)
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_ORGANIZATION_NAME=Demo Coffee
APPLE_WWDR_CERT=./credentials/AppleWWDR.pem
APPLE_SIGNER_CERT=./credentials/signerCert.pem
APPLE_SIGNER_KEY=./credentials/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
